{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TOW: Run on Phone",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/tow-run-on-phone.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "TOW: Logcat (Inspector)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/tow-logcat-app.ps1"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TOW: Pull voice recordings",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/tow-pull-voice.ps1"
      ],
      "problemMatcher": []
    }
  ]
}